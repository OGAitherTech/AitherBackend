# Local development configuration only.
# Secrets must be supplied through Render/environment variables and must not be committed.
APP_NAME=AitherBackend
APP_VERSION=2.7.1
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://aitherforge.github.io
DATABASE_URL=sqlite:///./aither.db
SESSION_TTL_HOURS=168
SECURE_COOKIES=true
COOKIE_SAMESITE=none
APP_URL=https://aitherforge.github.io
VERIFICATION_BASE_URL=https://aitherbackend.onrender.com
VERIFICATION_TOKEN_HOURS=24

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=onboarding@resend.dev
SMTP_FROM_NAME=Aither

OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=openai/gpt-oss-120b
AI_TEMPERATURE=0.7
AI_TIMEOUT_SECONDS=90
